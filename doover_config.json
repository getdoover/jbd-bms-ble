                    "hidden": false,
                    "children": {
                        "cycles": {
                            "name": "cycles",
                            "type": "uiVariable",
                            "displayString": "Cycles",
                            "showActivity": true,
                            "position": 69,
                            "hidden": false,
                            "varType": "float",
                            "currentValue": "$tag.app().cycles:number:null",
                            "decPrecision": 0
                        },
                        "nominal_ah": {
                            "name": "nominal_ah",
                            "type": "uiVariable",
                            "displayString": "Rated Capacity",
                            "showActivity": true,
                            "position": 70,
                            "hidden": false,
                            "units": "Ah",
                            "varType": "float",
                            "currentValue": "$tag.app().nominal_ah:number:null",
                            "decPrecision": 1
                        },
                        "cell_count": {
                            "name": "cell_count",
                            "type": "uiVariable",
                            "displayString": "Cell Count",
                            "showActivity": true,
                            "position": 71,
                            "hidden": false,
                            "varType": "float",
                            "currentValue": "$tag.app().cell_count:number:null",
                            "decPrecision": 0
                        },
                        "charge_fet": {
                            "name": "charge_fet",
                            "type": "uiVariable",
                            "displayString": "Charge MOSFET On",
                            "showActivity": true,
                            "position": 72,
                            "hidden": false,
                            "varType": "bool",
                            "currentValue": "$tag.app().charge_fet:boolean:true",
                            "live": true
                        },
                        "discharge_fet": {
                            "name": "discharge_fet",
                            "type": "uiVariable",
                            "displayString": "Discharge MOSFET On",
                            "showActivity": true,
                            "position": 73,
                            "hidden": false,
                            "varType": "bool",
                            "currentValue": "$tag.app().discharge_fet:boolean:true",
                            "live": true
                        },
                        "protection_text": {
                            "name": "protection_text",
                            "type": "uiVariable",
                            "displayString": "Protection",
                            "showActivity": true,
                            "position": 74,
                            "hidden": false,
                            "varType": "string",
                            "currentValue": "$tag.app().protection_text:string:\"none\""
