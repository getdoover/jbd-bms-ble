{
    "jbd_bms_ble": {
        "name": "jbd_bms_ble",
        "display_name": "JBD Bluetooth BMS",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Monitor and configure a JBD / Xiaoxiang Bluetooth BMS (iTechworld and most LiFePO4 batteries with a Bluetooth app) from a Doovit.",
        "long_description": "README.md",
        "depends_on": [],
        "organisation_id": null,
        "image_name": "ghcr.io/getdoover/jbd-bms-ble:main",
        "container_registry_profile_id": 93955828574386692,
        "build_args": "--platform linux/amd64,linux/arm64",
        "staging_config": {},
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "device_address": {
                    "title": "Battery Bluetooth Address",
                    "x-name": "device_address",
                    "x-hidden": false,
                    "type": [
                        "string",
                        "null"
                    ],
                    "x-required": false,
                    "description": "MAC address of the battery's BMS, e.g. A5:C2:37:17:A5:34. Leave blank, deploy, and press 'Scan for batteries' on the dashboard to find it.",
                    "default": "",
                    "x-position": 0
                },
                "poll_interval": {
                    "title": "Poll Interval (seconds)",
                    "x-name": "poll_interval",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How often to read the battery.",
                    "default": 10,
                    "x-position": 1,
                    "minimum": 2,
                    "maximum": 600
                },
                "settings_refresh_minutes": {
                    "title": "Settings Refresh (minutes)",
                    "x-name": "settings_refresh_minutes",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "How often the BMS configuration registers are re-read. They rarely change.",
                    "default": 60,
                    "x-position": 2,
                    "minimum": 1,
                    "maximum": 1440
                },
                "disconnect_between_polls": {
                    "title": "Disconnect Between Polls",
                    "x-name": "disconnect_between_polls",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Release the Bluetooth link after each poll so a phone app can still connect to the battery. Turn off for faster, lower-latency polling.",
                    "default": true,
                    "x-position": 3
                },
                "allow_settings_write": {
                    "title": "Allow Settings Changes",
                    "x-name": "allow_settings_write",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Let the BMS protection thresholds and capacity settings be changed from the dashboard. Off by default: a wrong value can stop the battery charging or discharging.",
                    "default": false,
                    "x-position": 4
                },
                "allow_mosfet_control": {
                    "title": "Allow Charge/Discharge Switching",
                    "x-name": "allow_mosfet_control",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Let the charge and discharge MOSFETs be switched from the dashboard. Switching discharge off cuts power to everything on the battery, including the device running this app.",
                    "default": false,
                    "x-position": 5
                },
                "low_soc_warning": {
                    "title": "Low State of Charge Warning (%)",
                    "x-name": "low_soc_warning",
                    "x-hidden": false,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Show a warning and send a notification when the state of charge drops below this.",
                    "default": 20,
                    "x-position": 6,
                    "minimum": 0,
                    "maximum": 100
                }
            },
            "additionalElements": true,
            "required": []
        },
        "ui_schema": {
            "displayString": "$config.app().APP_DISPLAY_NAME",
            "hidden": "$config.app().interpreter_hidden:boolean:false",
            "fullWidth": "$config.app().interpreter_full_width:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "soc": {
                    "name": "soc",
                    "type": "uiVariable",
                    "displayString": "State of Charge",
                    "showActivity": true,
                    "position": 51,
                    "hidden": false,
                    "units": "%",
                    "varType": "float",
                    "currentValue": "$tag.app().soc:number:null",
                    "decPrecision": 0,
                    "ranges": [
                        {
                            "min": 0,
                            "max": 20,
                            "colour": "red",
                            "show_on_graph": true,
                            "label": "Low"
                        },
                        {
                            "min": 20,
                            "max": 60,
                            "colour": "yellow",
                            "show_on_graph": true,
                            "label": "Medium"
                        },
                        {
                            "min": 60,
                            "max": 100,
                            "colour": "green",
                            "show_on_graph": true,
                            "label": "Good"
                        }
                    ],
                    "live": true
                },
                "pack_voltage": {
                    "name": "pack_voltage",
                    "type": "uiVariable",
                    "displayString": "Battery Voltage",
                    "showActivity": true,
                    "position": 52,
                    "hidden": false,
                    "units": "V",
                    "varType": "float",
                    "currentValue": "$tag.app().pack_voltage:number:null",
                    "decPrecision": 2,
                    "live": true
                },
                "current": {
                    "name": "current",
                    "type": "uiVariable",
                    "displayString": "Current",
                    "helpString": "Positive while charging, negative while discharging.",
                    "showActivity": true,
                    "position": 53,
                    "hidden": false,
                    "units": "A",
                    "varType": "float",
                    "currentValue": "$tag.app().current:number:null",
                    "decPrecision": 2,
                    "live": true
                },
                "power": {
                    "name": "power",
                    "type": "uiVariable",
                    "displayString": "Power",
                    "showActivity": true,
                    "position": 54,
                    "hidden": false,
                    "units": "W",
                    "varType": "float",
                    "currentValue": "$tag.app().power:number:null",
                    "decPrecision": 0,
                    "live": true
                },
                "charge_state": {
                    "name": "charge_state",
                    "type": "uiVariable",
                    "displayString": "State",
                    "showActivity": true,
                    "position": 55,
                    "hidden": false,
                    "varType": "string",
                    "currentValue": "$tag.app().charge_state:string:\"unknown\""
                },
                "remaining_ah": {
                    "name": "remaining_ah",
                    "type": "uiVariable",
                    "displayString": "Remaining Capacity",
                    "showActivity": true,
                    "position": 56,
                    "hidden": false,
                    "units": "Ah",
                    "varType": "float",
                    "currentValue": "$tag.app().remaining_ah:number:null",
                    "decPrecision": 1,
                    "live": true
                },
                "temperature": {
                    "name": "temperature",
                    "type": "uiVariable",
                    "displayString": "Battery Temperature",
                    "showActivity": true,
                    "position": 57,
                    "hidden": false,
                    "units": "\u00b0C",
                    "varType": "float",
                    "currentValue": "$tag.app().temperature:number:null",
                    "decPrecision": 1,
                    "ranges": [
                        {
                            "min": -20,
                            "max": 0,
                            "colour": "blue",
                            "show_on_graph": true,
                            "label": "Cold"
                        },
                        {
                            "min": 0,
                            "max": 45,
                            "colour": "green",
                            "show_on_graph": true,
                            "label": "Normal"
                        },
                        {
                            "min": 45,
                            "max": 80,
                            "colour": "red",
                            "show_on_graph": true,
                            "label": "Hot"
                        }
                    ],
                    "live": true
                },
                "comms_warning": {
                    "name": "comms_warning",
                    "type": "uiWarningIndicator",
                    "displayString": "No communication with battery",
                    "position": 58,
                    "hidden": "$tag.app().comms_ok:boolean:true",
                    "currentValue": "$cmds.app().comms_warning",
                    "can_cancel": true
                },
                "protection_warning": {
                    "name": "protection_warning",
                    "type": "uiWarningIndicator",
                    "displayString": "BMS protection active",
                    "position": 59,
                    "hidden": "$tag.app().protection_clear:boolean:true",
                    "currentValue": "$cmds.app().protection_warning",
                    "can_cancel": true
                },
                "low_soc_warning": {
                    "name": "low_soc_warning",
                    "type": "uiWarningIndicator",
                    "displayString": "Battery state of charge is low",
                    "position": 60,
                    "hidden": "$tag.app().soc_ok:boolean:true",
                    "currentValue": "$cmds.app().low_soc_warning",
                    "can_cancel": true
                },
                "charge_off_warning": {
                    "name": "charge_off_warning",
                    "type": "uiWarningIndicator",
                    "displayString": "Charging is switched off at the BMS",
                    "position": 61,
                    "hidden": "$tag.app().charge_fet:boolean:true",
                    "currentValue": "$cmds.app().charge_off_warning",
                    "can_cancel": true
                },
                "discharge_off_warning": {
                    "name": "discharge_off_warning",
                    "type": "uiWarningIndicator",
                    "displayString": "Discharging is switched off at the BMS",
                    "position": 62,
                    "hidden": "$tag.app().discharge_fet:boolean:true",
                    "currentValue": "$cmds.app().discharge_off_warning",
                    "can_cancel": true
                },
                "cells": {
                    "name": "cells",
                    "type": "uiSubmodule",
                    "displayString": "Cells",
                    "showActivity": true,
                    "position": 68,
                    "hidden": false,
                    "children": {
                        "cell_max": {
                            "name": "cell_max",
                            "type": "uiVariable",
                            "displayString": "Highest Cell",
                            "showActivity": true,
                            "position": 63,
                            "hidden": false,
                            "units": "mV",
                            "varType": "float",
                            "currentValue": "$tag.app().cell_max:number:null",
                            "decPrecision": 0,
                            "live": true
                        },
                        "cell_min": {
                            "name": "cell_min",
                            "type": "uiVariable",
                            "displayString": "Lowest Cell",
                            "showActivity": true,
                            "position": 64,
                            "hidden": false,
                            "units": "mV",
                            "varType": "float",
                            "currentValue": "$tag.app().cell_min:number:null",
                            "decPrecision": 0,
                            "live": true
                        },
                        "cell_delta": {
                            "name": "cell_delta",
                            "type": "uiVariable",
                            "displayString": "Cell Spread",
                            "showActivity": true,
                            "position": 65,
                            "hidden": false,
                            "units": "mV",
                            "varType": "float",
                            "currentValue": "$tag.app().cell_delta:number:null",
                            "decPrecision": 0,
                            "ranges": [
                                {
                                    "min": 0,
                                    "max": 30,
                                    "colour": "green",
                                    "show_on_graph": true,
                                    "label": "Balanced"
                                },
                                {
                                    "min": 30,
                                    "max": 80,
                                    "colour": "yellow",
                                    "show_on_graph": true,
                                    "label": "Drifting"
                                },
                                {
                                    "min": 80,
                                    "max": 500,
                                    "colour": "red",
                                    "show_on_graph": true,
                                    "label": "Unbalanced"
                                }
                            ],
                            "live": true
                        },
                        "cells_text": {
                            "name": "cells_text",
                            "type": "uiVariable",
                            "displayString": "Cell Voltages",
                            "showActivity": true,
                            "position": 66,
                            "hidden": false,
                            "varType": "string",
                            "currentValue": "$tag.app().cells_text:string:\"\""
                        },
                        "balancing": {
                            "name": "balancing",
                            "type": "uiVariable",
                            "displayString": "Balancing",
                            "showActivity": true,
                            "position": 67,
                            "hidden": false,
                            "varType": "string",
                            "currentValue": "$tag.app().balancing:string:\"none\""
                        }
                    }
                },
                "details": {
